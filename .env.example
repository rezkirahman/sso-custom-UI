# ZITADEL Identity Provider Configuration
ZITADEL_ISSUER="https://sso.agforce.co.id"

# ZITADEL Service Account Authentication
# Opsi 1 (Direkomendasikan): Service Account Key JSON di-encode ke Base64 (OAuth2 JWT Profile)
# Generate key di ZITADEL Console -> Service User -> Keys -> Add Key -> Download JSON
# Lalu encode ke base64 (misal: base64 -w 0 key.json) dan paste di bawah:
ZITADEL_KEY_BASE64="your-service-account-key-json-in-base64"

# Opsi 2 (Alternatif): Personal Access Token (PAT) Service Account
# Gunakan jika tidak memakai Key JSON
ZITADEL_PAT="your-service-account-pat-token"

# RSA Keypair untuk Enkripsi Password Client-to-Server
# Generate otomatis via command: node scripts/generate-rsa-key.js
RSA_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Session Cookie Encryption (iron-session)
# Minimal 32 karakter, generate otomatis via command: node scripts/generate-session-secret.js
SESSION_SECRET="your-32-characters-minimum-secret-key"

# Optional App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
